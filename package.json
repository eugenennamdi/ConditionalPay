{
  "name": "conditionalpay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run check:test-vectors && npm run test:frontend && npm run test:sdk",
    "test:frontend": "node test/regression-duplicate-guard.test.mjs",
    "test:sdk": "tsc -p packages/sdk/tsconfig.json && node --test packages/sdk/dist/test/*.test.js",
    "generate:test-vectors": "node scripts/generate-cairo-vectors.mjs",
    "check:test-vectors": "node scripts/generate-cairo-vectors.mjs --check"
  },
  "dependencies": {
    "@conditionalpay/sdk": "*",
    "@starknet-io/get-starknet-discovery": "6.0.4",
    "@starknet-io/get-starknet-wallet-standard": "6.0.4",
    "next": "^16.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.34.5",
    "starknet": "10.7.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@starknet-io/types-js": "0.10.4-beta.2",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
