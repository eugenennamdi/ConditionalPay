{
  "name": "conditionalpay",
  "version": "0.1.0",
  "description": "Programmable private settlement infrastructure for STRK20 on Starknet",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenennamdi/ConditionalPay.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run build --workspace @conditionalpay/sdk",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run check:test-vectors && npm run test:frontend && npm run test:sdk",
    "test:frontend": "node --test test/*.test.mjs",
    "test:sdk": "tsc -p packages/sdk/tsconfig.json && node --test packages/sdk/dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "generate:test-vectors": "node scripts/generate-cairo-vectors.mjs",
    "check:test-vectors": "node scripts/generate-cairo-vectors.mjs --check"
  },
  "dependencies": {
    "@conditionalpay/sdk": "*",
    "@starknet-io/get-starknet-discovery": "6.0.4",
    "@starknet-io/get-starknet-wallet-standard": "6.0.4",
    "next": "^16.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.34.5",
    "starknet": "10.7.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@starknet-io/types-js": "0.10.4-beta.2",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.16.0"
}
